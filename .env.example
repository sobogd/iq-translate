# Local runtime config for IQ Translate (translator). Copy to .env.local
# (git-ignored) for `next dev`; in prod deploy.yml writes these to .env on the
# VPS from GitHub secrets (never committed). Missing keys degrade gracefully —
# without SMTP the OTP email is skipped, without Google/Apple the provider
# buttons hide, etc. Real secret values only ever live in your local .env.local
# and in GitHub secrets (see AGENTS.md on secrets handling).

# Server port for `next start`/PM2 (deploy passes PORT=8200 inline — next start
# ignores PORT from .env files, so this only matters for manual starts).
PORT=8200

# Postgres for accounts + OTP challenges. Local dev reuses the shared local
# Postgres (create the database first: `createdb translator`).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/translator

# Translation engine: llama.cpp on the owner's Mac (see docs/local-llm.md).
# Locally the engine listens on 1234; on the VPS the same engine arrives over
# the owner's reverse-SSH tunnel as 18812. LLM_CTX must match the server's
# `-c`/`--ctx-size` — the whole request budget is derived from it
# (lib/llm-limits.ts). LLM_REASONING=none keeps a reasoning model from spending
# the answer on thinking and returning no text at all; LLM_TEMPLATE_KWARGS is
# the same switch for engines that want it inside the chat template.
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=
LLM_CTX=32768
LLM_REASONING=none
LLM_TEMPLATE_KWARGS={"enable_thinking":false}
LLM_TIMEOUT_MS=600000
LLM_IDLE_TIMEOUT_MS=120000

# Speech-to-text: whisper.cpp on the same Mac, reached the same way (1238
# locally, 18818 through the tunnel). The model is chosen when the server is
# started (`-m`), so only the address and the timeout are configured here;
# STT_TIMEOUT_MS covers the model load on a cold start, not just the
# transcription.
STT_BASE_URL=http://127.0.0.1:1238
STT_TIMEOUT_MS=240000

# S3-compatible object storage (see lib/s3.ts) — host/region/key/bucket.
S3_HOST=<s3-endpoint>
S3_REGION=<region>
S3_KEY=<access-key-id>
S3_TOKEN=<secret-access-key>
S3_NAME=<bucket-name>

# Google account sign-in (OAuth client). ALLOWED_GOOGLE_EMAILS is an optional
# comma-separated allow-list of Google accounts that may open an account.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
ALLOWED_GOOGLE_EMAILS=

# Email OTP sign-in (SMTP) — Brevo's transactional relay
# (smtp-relay.brevo.com), same relay as iq-mermaid. The from-domain
# iq-translate.com must be authenticated in Brevo (DKIM/SPF).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP_USER is the Brevo SMTP login (account email or <hash>@smtp-brevo.com);
# SMTP_PASS is an SMTP key (starts with "xsmtpsib-", ~90 chars) — NOT the API
# key (xkeysib-) and NOT a Gmail app password. Both come from
# Brevo dashboard → Settings → SMTP & API. Fill them only locally, by hand.
SMTP_USER=<brevo-smtp-login>
SMTP_PASS=<brevo-smtp-key>
# The "from" address shown on the OTP email — a sender on the authenticated
# iq-translate.com domain (here: the support mailbox).
FROM_EMAIL=support@iq-translate.com

# Sign in with Apple.
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_SERVICES_ID=<apple-services-id>
APPLE_PRIVATE_KEY=<apple-private-key-p8>

# Stripe billing.
STRIPE_SECRET_KEY=<sk_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>

# Cloudflare Turnstile gate for anonymous use (lib/turnstile.ts). TS_SITE is
# the public site key; NEXT_PUBLIC_TS_SITE is the same value, inlined at build
# time because the pages are statically prerendered.
TS_SITE=<turnstile-site-key>
TS_SECRET=<turnstile-secret-key>
NEXT_PUBLIC_TS_SITE=<turnstile-site-key>

# Cookieless analytics: events are relayed to iq-metrix (lib/analytics/ingest.ts).
# INGEST_SHARED_SECRET must match the X-Ingest-Key iq-metrix expects; the two
# email lists default to support@iq-rest.com in code when unset
# (see docs/analytics.md).
INGEST_SHARED_SECRET=<ingest-shared-secret>
ANALYTICS_ADMIN_EMAILS=
ANALYTICS_EXCLUDE_EMAILS=

# OCR sidecar (services/ocr) — server-side only.
OCR_SIDECAR_URL=http://127.0.0.1:8701
