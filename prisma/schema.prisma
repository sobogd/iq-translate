generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One conversation per language pair, per owner.
//
// Ownership is either a verified email (all three sign-in methods end there) or
// the browser's anonymous id cookie ("an:<id>", minted by proxy.ts) for someone
// who has not signed in. On sign-in the anonymous history is merged into the
// account (see lib/merge-conversations.ts).
//
// The pair is CANONICAL — sourceLang is lexicographically smaller — so en<->es
// is a single row whichever side the visitor writes in; writeLang records the
// side the next message comes from and is flipped by the swap button.
model Conversation {
  id           String        @id @default(cuid())
  ownerKey     String // verified email or "an:<anonymous cookie value>"
  sourceLang   String // ISO 639-1, smaller half of the pair
  targetLang   String // ISO 639-1, larger half
  writeLang    String // one of the pair: the side being written now
  lastUsedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  translations Translation[]

  @@unique([ownerKey, sourceLang, targetLang])
  @@index([ownerKey])
  @@map("conversations")
}

model Session {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime? // null = never expires (until logout/cache clear)
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("sessions")
}

// Email sign-in challenges (OTP). Identity is the lowercased, verified email
// (same key as Session/Conversation); the row holds the current pending
// challenge only — hashed code, expiry and the failed-attempt counter.
model OtpCode {
  email     String   @id
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

model Translation {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceLang     String // ISO 639-1 code
  transcript     String
  translation    String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("translations")
}

// ---------------------------------------------------------------------------
// Analytics used to live here too (AnalyticsSalt / SessionNew / EventNew —
// cookieless, salt-hashed visits, ported from iq-rest's analytics-v2
// pipeline). That pipeline moved to iq-metrix, a standalone ingest service;
// see lib/analytics/ingest.ts and docs/analytics.md.
//
// The three models are gone from here on purpose but the physical tables
// (analytics_salt / sessions_new / events_new) are deliberately left in place
// as a safety net rather than dropped — Prisma only stops tracking them, no
// migration runs. Safe to actually drop once iq-metrix has proven itself.
// ---------------------------------------------------------------------------
